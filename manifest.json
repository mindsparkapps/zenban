{
  "id": "/zenban-kanban",
  "name": "ZenBan • Tablero Kanban & Todo",
  "short_name": "ZenBan",
  "description": "Tablero Kanban interactivo con soporte táctil, gestos de zoom y arrastre de tarjetas para móvil y escritorio.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0f17",
  "theme_color": "#6366f1",
  "categories": ["productivity", "utilities"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "image/png", "image/jpeg", "image/webp", "image/gif"]
        }
      ]
    }
  },
  "widgets": [
    {
      "name": "ZenBan · Pendientes",
      "short_name": "ZenBan",
      "description": "Tus tareas pendientes más importantes (urgentes, vencidas y por vencer).",
      "tag": "zenban-tasks",
      "template": "zenban-tasks",
      "ms_ac_template": "widgets/tasks-template.json",
      "data": "widgets/tasks-data.json",
      "type": "application/json",
      "screenshots": [
        { "src": "icons/icon-512.png", "sizes": "512x512", "label": "Widget de ZenBan con tus pendientes" }
      ],
      "icons": [
        { "src": "icons/icon-192.png", "sizes": "192x192" }
      ],
      "auth": false,
      "update": 900
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
